<Window x:Class="WorkflowTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workflow Tracker" Width="80" Height="80"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Loaded="Window_Loaded" Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized">
  <Grid Margin="6">
    <Button x:Name="ToggleButton" Click="ToggleButton_Click"
            PreviewMouseLeftButtonDown="ToggleButton_MouseLeftButtonDown"
            PreviewMouseMove="ToggleButton_MouseMove"
            AutomationProperties.Name="Opname starten of pauzeren"
            Foreground="White" Background="#263348" BorderBrush="#60758F"
            BorderThickness="1" Cursor="Hand">
      <Button.ContextMenu>
        <ContextMenu Opened="ContextMenu_Opened">
          <MenuItem x:Name="StatusMenu" Header="Gepauzeerd" IsEnabled="False" />
          <Separator />
          <MenuItem Header="Instellingen…" Click="Settings_Click" />
          <MenuItem x:Name="StartupMenu" Header="Starten bij aanmelden"
                    IsCheckable="True" Click="Startup_Click" />
          <MenuItem Header="Logbestand openen" Click="OpenLog_Click" />
          <Separator />
          <MenuItem Header="Afsluiten" Click="Exit_Click" />
        </ContextMenu>
      </Button.ContextMenu>
      <Button.Template>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Ellipse x:Name="Circle" Fill="{TemplateBinding Background}"
                     Stroke="{TemplateBinding BorderBrush}"
                     StrokeThickness="1" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Circle" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Circle" Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Button.Template>
      <Grid Width="24" Height="26" IsHitTestVisible="False">
        <Path x:Name="PlayIcon" Data="M 5,2 L 23,13 L 5,24 Z" Fill="White" />
        <Path x:Name="PauseIcon" Data="M 3,2 H 9 V 24 H 3 Z M 15,2 H 21 V 24 H 15 Z"
              Fill="White" Visibility="Collapsed" />
      </Grid>
    </Button>
  </Grid>
</Window>
