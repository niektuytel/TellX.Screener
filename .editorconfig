root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,ps1}]
indent_style = space
indent_size = 4

[*.{xaml,json,yaml,yml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{md,json,yaml,yml,txt}]
end_of_line = lf
