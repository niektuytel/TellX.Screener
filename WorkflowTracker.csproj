<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Frameworkreferenties voor System.Drawing.Common en DPAPI; de UI blijft uitsluitend WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>WorkflowTracker</AssemblyName>
    <Version>1.3.2</Version>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <!-- WPF beheert DPI via het manifest; er wordt geen WinForms Application gestart. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="workflowtracker.defaults.json" />
    <EmbeddedResource Include="Services\UninstallCleanup.ps1" />
    <Compile Remove="Tests\**\*.cs" />
    <None Remove="Tests\**" />
    <Page Remove="Tests\**\*.xaml" />
  </ItemGroup>
</Project>
